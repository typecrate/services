# Rust artifacts normally land in the repo-root .rust/target (the root
# .cargo/config.toml sets target-dir), so `target/` only appears if someone
# builds with an explicit --target-dir or outside that config.
target/
/rust/target/

# wasm-bindgen output: regenerated by `npm run build:wasm` (cargo artifact +
# wasm-bindgen CLI glue). Build products, not sources - same policy as
# packages/underload/nexus/.gitignore. The rust/README.md alternative (commit
# pkg/) only applies if CI has to publish without a Rust toolchain.
pkg/
dist/

node_modules/
*.log

# NOTE: Cargo.lock is NOT ignored. This package is a standalone Cargo workspace,
# so its lock is its own (the root lock is separate). It is committed because the
# cargo scripts and scripts/build-wasm.mjs all run with --locked, and because the
# wasm-bindgen CLI version is read out of it - deleting or stale-ing the lock is a
# deliberate `cargo generate-lockfile`, never a side effect of an npm script.
